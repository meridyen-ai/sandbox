# =============================================================================
# Meridyen Sandbox - Environment Configuration
# =============================================================================

# Authentication provider: static, remote, noop
SANDBOX_AUTHENTICATION__PROVIDER=static

# Remote auth provider URL (for validating API keys via external service)
# SANDBOX_AUTHENTICATION__REMOTE_URL=https://your-auth-api.com/api/v1/validate-key
# SANDBOX_AUTHENTICATION__REMOTE_TIMEOUT=5.0

# User authentication (username/password for web UI login)
SANDBOX_AUTH_USERNAME=admin
SANDBOX_AUTH_PASSWORD=admin123
SANDBOX_AUTH_JWT_SECRET=sandbox-jwt-secret-change-me-to-something-secure

# Database network (Docker)
DATABASE_NETWORK=client-databases
DATABASE_NETWORK_EXTERNAL=false

# Port mappings
SANDBOX_REST_PORT=38082
SANDBOX_GRPC_PORT=50051
SANDBOX_METRICS_PORT=9090
SANDBOX_FRONTEND_PORT=5180

# =============================================================================
# LLM Service (vLLM)
# =============================================================================

# HuggingFace token (required for gated models like Llama)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=

# Model to serve (any HuggingFace model ID)
# Uncomment ONE model below. Reference: 2x RTX PRO 6000 (96GB each, 192GB total)
#
# --- Code-specialized models ---
# VLLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct          # 1 GPU, ~68GB,  up to 65K ctx — best code model for speed
# VLLM_MODEL=deepseek-ai/DeepSeek-Coder-V2-Instruct    # 2 GPU, ~160GB, up to 16K ctx — 236B MoE, strongest code benchmarks
# VLLM_MODEL=meta-llama/CodeLlama-70b-Instruct-hf      # 2 GPU, ~140GB, up to 16K ctx — Meta's dedicated code LLM
# VLLM_MODEL=meta-llama/CodeLlama-34b-Instruct-hf      # 1 GPU, ~70GB,  up to 32K ctx — smaller CodeLlama, fast
# VLLM_MODEL=deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct # 1 GPU, ~34GB, up to 65K ctx — lightweight, very fast
#
# --- General + code models ---
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct            # 2 GPU, ~140GB, up to 16K ctx — best all-round + code
# VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct                 # 2 GPU, ~145GB, up to 16K ctx — strong reasoning + code
# VLLM_MODEL=mistralai/Mistral-Large-Instruct-2411      # 2 GPU, ~180GB, up to 16K ctx — 123B, multilingual
# VLLM_MODEL=deepseek-ai/DeepSeek-V3                    # 2 GPU, ~160GB, up to 8K ctx  — 671B MoE, largest
#
# --- Small / fast single-GPU models ---
# VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct           # 1 GPU, ~17GB,  up to 32K ctx — fast prototyping
# VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct            # 1 GPU, ~15GB,  up to 32K ctx — smallest good code model

# API key to protect the vLLM endpoint (optional, leave empty for no auth)
VLLM_API_KEY=

# Port for the OpenAI-compatible API
VLLM_PORT=8000

# GPU configuration (set GPUS via Makefile: make llm-up GPUS=2)
VLLM_GPU_COUNT=all
VLLM_TENSOR_PARALLEL=1

# Inference tuning
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTIL=0.95
VLLM_DTYPE=auto
VLLM_MAX_NUM_SEQS=128
VLLM_MAX_BATCHED_TOKENS=8192
VLLM_SWAP_SPACE=4
VLLM_SCHEDULER_STEPS=1
